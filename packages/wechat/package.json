{
  "name": "@centui/wechat",
  "version": "0.1.0",
  "description": "centui WeChat mini-program components — same design tokens & behavior as the Vue/React versions (750rpx design basis)",
  "license": "Apache-2.0",
  "miniprogram": "dist",
  "files": [
    "dist"
  ],
  "exports": {
    "./components/*": "./dist/components/*",
    "./styles/*": "./dist/styles/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.1.1",
    "@centui/core": "workspace:*",
    "autoprefixer": "^10.4.20",
    "cssnano": "^9.9.0",
    "esbuild": "^0.28.2",
    "miniprogram-api-typings": "^5.2.3",
    "postcss": "^8.5.31",
    "stylus": "^0.64.0",
    "vite-plugin-dts": "^5.1.0"
  }
}
