<view
  class="cu-steps cu-steps-{{direction}} {{direction === 'vertical' && verticalAdaptive ? 'vertical-adaptive' : ''}} {{noCurrent ? 'no-current' : ''}}"
>
  <block wx:if="{{custom}}">
    <slot></slot>
  </block>
  <block wx:else>
    <block wx:for="{{steps}}" wx:for-item="step" wx:for-index="index" wx:key="index">
      <view class="step-wrapper {{stepStatus[index]}}">
        <view class="icon-wrapper">
          <block wx:if="{{index < currentLength}}">
            <view class="step-node-default">
              <view class="step-node-default-icon" style="width: 6px; height: 6px; border-radius: 50%"></view>
            </view>
          </block>
          <block wx:elif="{{index === currentLength}}">
            <cu-icon name="success" color="var(--steps-color-active)"></cu-icon>
          </block>
          <block wx:else>
            <view class="step-node-default">
              <view class="step-node-default-icon" style="width: 6px; height: 6px; border-radius: 50%"></view>
            </view>
          </block>
        </view>
        <view class="text-wrapper">
          <view class="name">{{step.name}}</view>
          <view wx:if="{{step.text}}" class="desc">{{step.text}}</view>
        </view>
      </view>
      <view class="bar {{direction === 'horizontal' ? 'horizontal-bar' : 'vertical-bar'}}" style="{{barStyles[index]}}">
        <view wx:if="{{progress[index]}}" class="bar-inner" style="{{barInnerStyles[index]}}"></view>
      </view>
    </block>
  </block>
</view>
