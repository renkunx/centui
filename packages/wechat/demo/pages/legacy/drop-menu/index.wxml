<view class="legacy-wrapper md-example drop-menu">
  <view class="legacy-section">
    <view class="legacy-title">基础下拉菜单</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-drop-menu md-example-child-drop-menu-0">
    <cu-drop-menu data="{{data}}" />
    <view class="content">正文区域</view>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">初始下拉菜单</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-drop-menu md-example-child-drop-menu-1">
    <cu-drop-menu data="{{data}}" default-value="{{['1', '8']}}" />
    <view class="content">正文区域</view>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">禁用下拉菜单</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-drop-menu md-example-child-drop-menu-2">
    <cu-drop-menu data="{{data}}" default-value="{{['1', '8']}}" />
    <view class="content">正文区域</view>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">自定义菜单项</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-drop-menu md-example-child-drop-menu-3">
    <cu-drop-menu data="{{data}}">
      <template slot-scope="{ option }">
        <view class="md-drop-menu-custom-title" v-text="option.text"></view>
        <view class="md-drop-menu-custom-brief">{{ option.text }}【可使用slot-scope进行自定义描述】</view>
      </template>
    </cu-drop-menu>
    <view class="content">正文区域</view>
  </view>

    </view>
  </view>
</view>
