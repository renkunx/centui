@import "../legacy.wxss";

.md-example-child-drop-menu-3 .md-drop-menu-custom-title {
  font-size: 28px;
  text-align: center;
}
.md-example-child-drop-menu-3 .md-drop-menu-custom-brief {
  font-size: 20px;
  color: #999;
  text-align: center;
}

.md-example.drop-menu .md-example-section {
  position: relative;
}
.md-example.drop-menu .md-example-section .md-example-child {
  position: relative;
  height: 400px;
  background: color-bg-base;
  overflow: hidden;
}
.md-example.drop-menu .md-example-section .md-example-child .md-drop-menu {
  position: absolute;
  float: left;
  width: 100%;
  height: 100%;
}
.md-example.drop-menu .md-example-section .md-example-child .md-drop-menu .md-drop-menu-bar {
  height: drop-menu-height;
}
.md-example.drop-menu .md-example-section .md-example-child .md-drop-menu .md-popup {
  position: absolute;
}
.md-example.drop-menu .md-example-section .md-example-child .content {
  font-size: font-body-normal;
  text-align: center;
  line-height: 400px;
}

