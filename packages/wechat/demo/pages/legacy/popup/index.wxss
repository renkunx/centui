@import "../legacy.wxss";

.md-example-child-popup-0 {
  float: left;
  width: 100%;
}
.md-example-child-popup-0 .md-button {
  margin-bottom: 20px;
}
.md-example-child-popup-0 .md-example-popup {
  position: relative;
  font-size: 28px;
  font-family: 'Helvetica Neue';
  font-weight: 500;
  box-sizing: border-box;
  text-align: center;
  background-color: #fff;
}
.md-example-child-popup-0 .md-example-popup-center {
  padding: 50px;
  border-radius: radius-normal;
}
.md-example-child-popup-0 .md-example-popup-top {
  width: 100%;
  height: 75px;
  line-height: 75px;
  background: #4a4c5b;
  color: #fff;
}
.md-example-child-popup-0 .md-example-popup-top .md-icon {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
}
.md-example-child-popup-0 .md-example-popup-bottom {
  width: 100%;
  padding: 100px 0;
}
.md-example-child-popup-0 .md-example-popup-bottom p {
  line-height: 50px;
}
.md-example-child-popup-0 .md-example-popup-left,
.md-example-child-popup-0 .md-example-popup-right {
  height: 100%;
  padding: 0 150px;
  display: flex;
  align-items: center;
}

.md-example-child-popup-2 {
  float: left;
  width: 100%;
}
.md-example-child-popup-2 .md-button {
  margin-bottom: 20px;
}
.md-example-child-popup-2 .md-popup-title-bar .md-popup-cancel .md-icon {
  align-self: flex-start;
  margin-left: 32px;
}
.md-example-child-popup-2 .md-example-popup {
  position: relative;
  font-size: font-minor-large;
  background: color-bg-base;
  box-sizing: border-box;
  text-align: center;
  background-color: #fff;
}
.md-example-child-popup-2 .md-example-popup-align {
  padding: 0 40px;
}
.md-example-child-popup-2 .md-example-popup-align .md-scroll-view {
  height: 500px;
  background: #eee;
}
.md-example-child-popup-2 .md-example-popup-align .md-scroll-view p {
  line-height: 500px;
  font-size: 64px;
  font-weight: 200;
  color: #999;
}
.md-example-child-popup-2 .md-example-popup-top {
  width: 100%;
  height: 75px;
  line-height: 75px;
  background: #4a4c5b;
  color: #fff;
}
.md-example-child-popup-2 .md-example-popup-top .md-icon {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
}
.md-example-child-popup-2 .md-example-popup-bottom {
  width: 100%;
  padding: 0 0 150px;
}
.md-example-child-popup-2 .md-example-popup-bottom p {
  margin-bottom: 100px;
  font-size: 64px;
  font-weight: 200;
  color: #999;
}
.md-example-child-popup-2 .md-example-popup-left,
.md-example-child-popup-2 .md-example-popup-right {
  height: 100%;
  padding: 0 150px;
  display: flex;
  align-items: center;
}

