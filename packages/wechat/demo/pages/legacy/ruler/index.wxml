<view class="legacy-wrapper md-example ruler">
  <view class="legacy-section">
    <view class="legacy-title">基本</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-single-component">
    <view class="legacy-p">当前值：{{ value }}</view>
    <view class="container">
      <cu-ruler
        scope="{{scope}}"
        step="{{100}}"
        unit="{{10}}"
        value="{{value}}" bind:change="noop"
      ></cu-ruler>
    </view>
	</view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">最大1800，最小1200</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-single-component">
    <view class="legacy-p">当前值：{{ value }}</view>
    <view class="container">
      <cu-ruler
        scope="{{scope}}"
        step="{{100}}"
        unit="{{10}}"
        max="{{1800}}"
        min="{{1200}}"
        value="{{value}}" bind:change="noop"
      ></cu-ruler>
    </view>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">触发 <a href="javascript:window.triggerRuler2()">Change to 1500</a></view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-single-component">
    <view class="legacy-p">当前值：{{ value }}</view>
    <view class="container">
      <cu-ruler
        scope="{{scope}}"
        step="{{100}}"
        unit="{{10}}"
        max="{{2000}}"
        min="{{1000}}"
        value="{{value}}" bind:change="noop"
      ></cu-ruler>
    </view>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">自定义step展示文案</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-single-component">
    <view class="legacy-p">当前值：{{ value }}</view>
    <view class="container">
      <cu-ruler
        value="{{value}}" bind:change="noop"
        scope="{{scope}}"
        step="{{100}}"
        unit="{{10}}"
        step-text-render="{{stepTextRender}}"
      ></cu-ruler>
    </view>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">自定义step展示位置</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-single-component">
    <view class="legacy-p">当前值：{{ value }}</view>
    <view class="container">
      <cu-ruler
        value="{{value}}" bind:change="noop"
        step-text-position="bottom"
        scope="{{scope}}"
        step="{{100}}"
        unit="{{10}}"
      ></cu-ruler>
    </view>
  </view>

    </view>
  </view>
</view>
