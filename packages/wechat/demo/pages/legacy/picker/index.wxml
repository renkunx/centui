<view class="legacy-wrapper md-example picker">
  <view class="legacy-section">
    <view class="legacy-title">单列数据 <text class="title-link" bind:tap="getColumnValues0">getColumnValues</text><text class="title-link" bind:tap="getColumnIndexs0">getColumnIndexs</text><text class="title-link" bind:tap="setColumnValues0">setColumnValues</text></view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-picker md-example-child-picker-0">
    <cu-picker
      id="pickerDemo0"
      data="{{pickerData}}"
      invalid-index="{{[[2, 3, 4]]}}"
      bind:initialed="onPickerInitialed0"
      bind:change="onPickerChange0"
      is-view
    ></cu-picker>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">联动数据 <text class="title-link" bind:tap="getColumnValue1">getColumnValue(0)</text><text class="title-link" bind:tap="getColumnIndex1">getColumnIndex(0)</text><text class="title-link" bind:tap="changeDefaultValue1">changeDefaultValue</text></view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-picker md-example-child-picker-1">
    <cu-picker
      id="pickerDemo1"
      data="{{pickerDataDistrict}}"
      cols="{{3}}"
      default-index="{{pickerDefaultIndex}}"
      default-value="{{pickerDefaultValue}}"
      is-view
      is-cascade
      bind:initialed="onPickerInitialed1"
      bind:change="onPickerChange1"
    ></cu-picker>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">弹出展示</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-picker md-example-child-picker-2">
    <cu-field>
      <cu-field-item
        title="起保年份"
        arrow="arrow"
        addon="{{pickerValue0}}"
        bind:click="showPicker0">
      </cu-field-item>
      <cu-field-item
        title="省市区/县"
        arrow="arrow"
        addon="{{pickerValue1}}"
        bind:click="showPicker1">
      </cu-field-item>
    </cu-field>
    <cu-picker
      id="picker0"
      show="{{isPickerShow0}}"
      bind:change="onPickerShowChange0"
      data="{{pickerData0}}"
      large-radius
      bind:confirm="onPickerConfirm0"
      title="选择年份"
    ></cu-picker>
    <cu-picker
      id="picker1"
      show="{{isPickerShow1}}"
      bind:change="onPickerShowChange1"
      data="{{pickerData1}}"
      cols="{{3}}"
      is-cascade
      large-radius
      title="选择省市区/县"
      bind:confirm="onPickerConfirm1"
    ></cu-picker>
  </view>

    </view>
  </view>
  <cu-dialog id="cu-dialog" />
</view>
<!--
  平台差异说明（对齐 legacy/components/picker/demo/cases/demo0~2.vue）：
  - 标题 javascript: 链接（getColumnValues 等 6 个）改为 title-link 按钮
  - v-model 改为 show 属性 + change 事件回写；@confirm="onPickerConfirm(0/1)" 拆分为两个 handler
  - Dialog.alert({content: pre 包裹的 JSON}) 改为页面放置 cu-dialog（id="cu-dialog"）+ show() 命令式调用
  - demo0/demo1 的 data 名拆分为 pickerData（simple）/ pickerDataDistrict（district）
  - setColumnValues 的第三参回调（vm.refresh）无平台等价物：组件内部已重建该列，选中归 0
  - getColumnValue 的 delete value.children 改为浅拷贝剔除，避免污染共享 district 数据
-->
