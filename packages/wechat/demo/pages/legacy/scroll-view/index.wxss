@import "../legacy.wxss";

.md-example-child-scroll-view-0 {
  height: 400px;
  background: #fff;
}
.md-example-child-scroll-view-0 .scroll-view-item {
  padding: 30px 0;
  text-align: center;
  font-size: 28px;
  font-family: 'Helvetica Neue';
  border-bottom: 0.5px solid #efefef;
}

.md-example-child-scroll-view-1 {
  height: 100px;
  background: #fff;
}
.md-example-child-scroll-view-1 .md-scroll-view {
  display: flex;
  align-items: center;
}
.md-example-child-scroll-view-1 .md-scroll-view .scroll-view-list {
  display: flex;
  width: 1000px;
}
.md-example-child-scroll-view-1 .md-scroll-view .scroll-view-list .scroll-view-item {
  flex: 1;
  text-align: center;
  font-size: 28px;
  font-family: 'Helvetica Neue';
  border-right: 0.5px solid #efefef;
}

.md-example-child-scroll-view-2 {
  height: 800px;
  background: #fff;
}
.md-example-child-scroll-view-2 .scroll-view-item {
  padding: 30px 0;
  text-align: center;
  font-size: 28px;
  font-family: 'Helvetica Neue';
  border-bottom: 0.5px solid #efefef;
}

.md-example-child-scroll-view-3 {
  height: 800px;
  background: #fff;
}
.md-example-child-scroll-view-3 .scroll-view-item {
  padding: 30px 0;
  text-align: center;
  font-size: 32px;
  font-family: 'Helvetica Neue';
  border-bottom: 0.5px solid #efefef;
}

.md-example-child-scroll-view-4 {
  position: relative;
  height: 800px;
  background: #fff;
}
.md-example-child-scroll-view-4 .scroll-view-striky-title {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
}
.md-example-child-scroll-view-4 .scroll-view-category-title,
.md-example-child-scroll-view-4 .scroll-view-striky-title {
  padding: 10px 0;
  text-align: center;
  font-size: 32px;
  font-family: 'Helvetica Neue';
  background-color: #f0f0f0;
}
.md-example-child-scroll-view-4 .scroll-view-item {
  padding: 30px 0;
  text-align: center;
  font-size: 32px;
  border-bottom: 0.5px solid #efefef;
}

.md-example-child-scroll-view-5 {
  position: relative;
  height: 800px;
  background: #fff;
}
/* cu-tabs 常规文档流替代 md-tab-bar 绝对定位覆盖；阴影沿用 */
.md-example-child-scroll-view-5 .cu-tab-bar {
  box-shadow: 0 2px 8px #f0f0f0;
}
.md-example-child-scroll-view-5 .scroll-view-with-tab-bar {
  height: 700px;
}
.md-example-child-scroll-view-5 .scroll-view-with-tab-bar .scroll-view-item {
  padding: 30px 0;
  text-align: center;
  font-size: 32px;
  border-bottom: 0.5px solid #efefef;
}

.md-example-child-scroll-view-6 {
  background: #fff;
}
.md-example-child-scroll-view-6 .content {
  height: 800px;
}
.md-example-child-scroll-view-6 .cu-tab-bar {
  box-shadow: 0 2px 8px #f0f0f0;
}
.md-example-child-scroll-view-6 .scroll-view-item {
  padding: 30px 0;
  text-align: center;
  font-size: 32px;
  font-family: 'Helvetica Neue';
  border-bottom: 0.5px solid #efefef;
}

/* cu-scroll-view-refresh 替代为内置刷新头（default-refresher）后的自绘样式（more.vue/refresh.vue 移植） */
.md-example-child-scroll-view .scroll-view-refresh {
  display: flex;
  padding: 50rpx 0;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}
.md-example-child-scroll-view .scroll-view-refresh .cu-activity-indicator-svg {
  width: 32rpx !important;
  height: 32rpx !important;
  transform: rotateZ(-45deg);
}
.md-example-child-scroll-view .scroll-view-refresh .refresh-tip {
  margin-left: 15rpx;
  font-size: 24rpx;
  color: #999;
}
.scroll-view-more-inner {
  display: block;
  padding: var(--v-gap-lg) 0;
  font-size: var(--font-minor-large);
  text-align: center;
  color: var(--color-text-caption);
}
.legacy-title .title-link {
  display: inline-block;
  margin-right: 5rpx;
  background: var(--color-primary);
  color: #fff;
  padding: 5rpx 10rpx;
  border-radius: var(--radius-normal);
  font-size: var(--font-minor-large);
  font-weight: var(--font-weight-light);
  line-height: 28rpx;
  text-decoration: none;
}

