<view class="legacy-wrapper md-example image-reader">
  <view class="legacy-section">
    <view class="legacy-title">图片选择</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-reader md-example-child-reader-0">
    <view class="image-reader-list">
      <view
        class="image-reader-item"
        wx:for="{{imageList.reader0}}" wx:key="*this"
        style="background-image: url({{item}}); background-position: center center; background-repeat: no-repeat; background-size: cover;"
      >
        <cu-tag
          class="image-reader-item-del"
          size="small"
          shape="quarter"
          fill-color="#111A34"
          type="fill"
          font-color="#fff"
          bind:tap="onDeleteImage0"
          data-index="{{index}}"
        >
          <cu-icon name="close"></cu-icon>
        </cu-tag>
      </view>
      <view class="image-reader-item add">
        <cu-image-reader
          name="reader0"
          bind:select="onReaderSelect"
          bind:complete="onReaderComplete"
          bind:error="onReaderError"
          is-multiple
        ></cu-image-reader>
        <cu-icon name="camera" size="md" color="#CCC"></cu-icon>
        <view class="legacy-p">添加图片</view>
      </view>
    </view>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">图片选择并轴向修正，压缩处理</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-reader md-example-child-reader-1">
    <view class="image-reader-list">
      <view
        class="image-reader-item"
        wx:for="{{imageList.reader1}}" wx:key="*this"
        style="background-image: url({{item}}); background-position: center center; background-repeat: no-repeat; background-size: cover;"
      >
        <cu-tag
          class="image-reader-item-del"
          size="small"
          shape="quarter"
          fill-color="#111A34"
          type="fill"
          font-color="#fff"
          bind:tap="onDeleteImage1"
          data-index="{{index}}"
        >
          <cu-icon name="close"></cu-icon>
        </cu-tag>
      </view>
      <view class="image-reader-item add">
        <cu-image-reader
          name="reader1"
          bind:select="onReaderSelect"
          bind:complete="onReaderComplete"
          bind:error="onReaderError"
          is-multiple
        ></cu-image-reader>
        <cu-icon name="camera" size="md" color="#CCC"></cu-icon>
        <view class="legacy-p">添加图片</view>
      </view>
    </view>
  </view>

    </view>
  </view>
  <cu-toast id="cu-toast" />
</view>
<!--
  平台差异说明（对齐 legacy/components/image-reader/demo/cases/demo0、demo1.vue）：
  - v-for + 动态 style（背景图）改为 wx:for + 静态 style 模板内插
  - ul/li 改为 view.image-reader-list/image-reader-item（样式等价）
  - @click.native="onDeleteImage(name, index)" 拆为 onDeleteImage0/1 + data-index
  - Toast.loading/hide/failed 改为页面 cu-toast 组件命令式调用
  - demo1 的 imageProcessor（canvas 压缩）无小程序移植，complete 载荷 dataUrl 直接入列
-->
