@import "../legacy.wxss";

.md-example-child-reader .image-reader-list {
  float: left;
  width: 100%;
}
.md-example-child-reader .image-reader-list .image-reader-item {
  position: relative;
  float: left;
  width: 23.5%;
  padding-bottom: 23.5%;
  margin-bottom: 2%;
  margin-right: 2%;
  background: #fff;
  box-shadow: 0 5px 20px rgba(197,202,213,0.25);
  box-sizing: border-box;
  list-style: none;
  border-radius: 4px;
  background-size: cover;
  overflow: hidden;
}
.md-example-child-reader .image-reader-list .image-reader-item:nth-of-type(4n) {
  margin-right: 0;
}
.md-example-child-reader .image-reader-list .image-reader-item.add .md-icon {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.5;
}
.md-example-child-reader .image-reader-list .image-reader-item.add p {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  margin-top: 15px;
  font-size: 22px;
  color: #ccc;
  text-align: center;
}
.md-example-child-reader .image-reader-list .image-reader-item .image-reader-item-del {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 3;
  opacity: 0.8;
}
.md-example-child-reader .image-reader-list .image-reader-item .image-reader-item-del .md-icon-close {
  font-size: 24px;
}

