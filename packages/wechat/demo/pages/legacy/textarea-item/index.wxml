<view class="legacy-wrapper md-example textarea-item">
  <view class="legacy-section">
    <view class="legacy-title">普通文本域</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-textarea md-example-child-textarea-0">
    <cu-field>
      <cu-textarea-item
        id="textarea0"
        title="普通"
        autosize
        class="example"
        value="{{value0}}" bind:change="onValue0Change"
        placeholder="普通文本域"
      />
      <cu-textarea-item
        id="textarea1"
        title="自动适应"
        class="example"
        autosize="{{true}}"
        value="{{value2}}" bind:change="onValue2Change"
        rows="{{1}}"
        placeholder="最大高度150px"
        max-height="{{150}}"
      />
      <cu-textarea-item
        id="textarea2"
        title="删除图标"
        class="example"
        autosize="{{true}}"
        clearable
        rows="{{1}}"
        placeholder="输入出现删除图标"
        max-height="{{150}}"
      />
      <cu-textarea-item
        title="禁用"
        class="example"
        autosize="{{true}}"
        value="禁用文本域, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述"
        placeholder="500字以内"
        max-height="{{150}}"
        disabled
      />
      <cu-textarea-item
        title="只读"
        class="example"
        autosize="{{true}}"
        value="只读文本域, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述"
        placeholder="500字以内"
        max-height="{{150}}"
        readonly
      />
      <cu-textarea-item
        id="textarea3"
        title="格式化"
        autosize
        class="example"
        value="{{value3}}" bind:change="onValue3Change"
        placeholder="去掉所有数字"
      />
    </cu-field>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">错误提示</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-textarea md-example-child-textarea-0">
    <cu-field>
      <cu-textarea-item
        title="错误提示"
        class="example"
        value="{{valueErr}}" bind:change="change"
        bind:blur="blur"
        bind:keyup="keyup"
        bind:keydown="keydown"
        bind:focus="focus"
        placeholder=""
        error="输入信息有误!"
      />

    </cu-field>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">插槽</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-textarea md-example-child-textarea-2">
    <cu-field>
      <cu-textarea-item
        class="demo2"
        autosize="{{true}}"
        value="{{valueD2}}" bind:change="onValueD2Change"
        max-length="{{100}}"
        max-height="{{150}}"
        placeholder="描述信息在100字以内"
      >
        <view slot="footer" class="legacy-p demo2-footer">
          <text
            class="demo2-footer-left"
            wx:if="{{valueD2.length > 0}}"
          >{{ valueD2.length }}/100</text>
          <text
            class="demo2-footer-right"
          >页脚文案</text>
        </view>
      </cu-textarea-item>
    </cu-field>
  </view>

    </view>
  </view>
</view>
<!--
  平台差异说明（对齐 legacy/components/textarea-item/demo/cases/demo0~2.vue）：
  - v-model 均改为 value + change 事件回写（各 case 字段拆分为 value0/value2/value3/valueErr/valueD2）
  - formation 函数属性无法经 wxml 传递，改为 onReady 里对格式化文本域 setFormation(fn) 注入
  - keyup/keydown 为 no-op 事件（小程序无对应），handler 保留仅对齐绑定
  - footer 插槽 value.length 计数改为 wx:if + data 绑定；空的 v-else 文本节点无展示意义，移除
  - 重复的 ref="demo0" 移除（组件实例改用 id 定位）
-->
