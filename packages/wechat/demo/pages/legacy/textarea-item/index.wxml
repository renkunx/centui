<view class="legacy-wrapper md-example textarea-item">
  <view class="legacy-section">
    <view class="legacy-title">普通文本域</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-textarea md-example-child-textarea-0">
    <cu-field>
      <cu-textarea-item
        ref="demo0"
        title="普通"
        autosize
        class="example"
        value="{{value}}" bind:change="noop"
        placeholder="普通文本域"
      />
      <cu-textarea-item
        ref="demo0"
        title="自动适应"
        class="example"
        autosize="{{true}}"
        value="{{value2}}" bind:change="noop"
        rows="{{1}}"
        placeholder="最大高度150px"
        max-height="{{150}}"
      />
      <cu-textarea-item
        ref="demo0"
        title="删除图标"
        class="example"
        autosize="{{true}}"
        clearable
        rows="{{1}}"
        placeholder="输入出现删除图标"
        max-height="{{150}}"
      />
      <cu-textarea-item
        ref="demo0"
        title="禁用"
        class="example"
        autosize="{{true}}"
        value="禁用文本域, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述"
        placeholder="500字以内"
        max-height="{{150}}"
        disabled
      />
      <cu-textarea-item
        ref="demo0"
        title="只读"
        class="example"
        autosize="{{true}}"
        value="只读文本域, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述, 理赔报案描述"
        placeholder="500字以内"
        max-height="{{150}}"
        readonly
      />
      <cu-textarea-item
        ref="demo0"
        title="格式化"
        autosize
        class="example"
        value="{{value3}}" bind:change="noop"
        formation="{{format}}"
        placeholder="去掉所有数字"
      />
    </cu-field>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">错误提示</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-textarea md-example-child-textarea-0">
    <cu-field>
      <cu-textarea-item
        ref="demo1"
        title="错误提示"
        class="example"
        value="{{value}}" bind:change="noop"
        bind:blur="blur"
        bind:change="change"
        bind:keyup="keyup"
        bind:keydown="keydown"
        bind:focus="focus"
        placeholder=""
        error="输入信息有误!"
      />

    </cu-field>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">插槽</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-textarea md-example-child-textarea-2">
    <cu-field>
      <cu-textarea-item
        ref="demo2"
        class="demo2"
        autosize="{{true}}"
        value="{{value}}" bind:change="noop"
        max-length="{{100}}"
        max-height="{{150}}"
        placeholder="描述信息在100字以内"
      >
        <template slot="footer">
          <view class="legacy-p" class="demo2-footer">
            <text
              class="demo2-footer-left"
              wx:if="{{value.length"
              >{{ value.length }}/100</text>
            <text v-else></text>

            <text
              class="demo2-footer-right"
              >页脚文案</text>
          </view>
        </template>
      </cu-textarea-item>
    </cu-field>
  </view>

    </view>
  </view>
</view>
