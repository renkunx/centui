@import "../legacy.wxss";

.md-example-child-image-reader {
  float: left;
  width: 100%;
}
.md-example-child-image-reader ul {
  float: left;
  width: 100%;
}
.md-example-child-image-reader ul li {
  position: relative;
  float: left;
  width: 22%;
  padding-bottom: 22%;
  margin-left: 2%;
  margin-top: 2%;
  border-sizing: border-box;
  border-radius: 2px;
  overflow: hidden;
  list-style: none;
}
.md-example-child-image-reader ul li .img {
  position: absolute;
  width: 100%;
  height: 100%;
}

