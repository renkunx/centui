<view class="legacy-wrapper md-example image-viewer">
  <view class="legacy-section">
    <view class="legacy-title">基础</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-image-reader">
    <view>
      <ul>
        <template v-for="(item, index) in imgs">
          <li bind:tap="showViewer(index, $event)" key="{{index}}">
            <view class="img"
              style="{{`background: url(${item}) center no-repeat;background-size:cover;`}}">
            </view>
          </li>
        </template>
      </ul>
    </view>
    <cu-image-viewer
      value="{{isViewerShow}}" bind:change="noop"
      list="{{imgs}}"
      has-dots="{{true}}"
      initial-index="{{viewerIndex}}">
    </cu-image-viewer>
  </view>

    </view>
  </view>
</view>
