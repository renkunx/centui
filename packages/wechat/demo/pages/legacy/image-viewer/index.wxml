<view class="legacy-wrapper md-example image-viewer">
  <view class="legacy-section">
    <view class="legacy-title">基础</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-image-reader">
    <view>
      <view class="img-list">
        <view
          class="img-item"
          wx:for="{{imgs}}" wx:key="*this"
          bind:tap="showViewer"
          data-index="{{index}}"
        >
          <view class="img" style="background: url({{item}}) center no-repeat; background-size: cover;"></view>
        </view>
      </view>
    </view>
    <cu-image-viewer
      show="{{isViewerShow}}"
      bind:change="onViewerChange"
      list="{{imgs}}"
      has-dots="{{true}}"
      initial-index="{{viewerIndex}}">
    </cu-image-viewer>
  </view>

    </view>
  </view>
</view>
<!--
  平台差异说明（对齐 legacy/components/image-viewer/demo/cases/demo0.vue）：
  - template v-for + ul/li 缩略图改为 view.img-list/img-item（wx:key="*this"）
  - @click="showViewer(index)" 改为 data-index + dataset
  - v-model 改为 show 属性 + change 事件回写
-->
