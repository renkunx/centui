<view class="legacy-wrapper md-example check">
  <view class="legacy-section">
    <view class="legacy-title">复选项</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-check md-example-child-check-0">
    <cu-check value="{{checked}}" bind:change="noop" label="复选项" />
    <cu-check label="禁用" disabled />
	</view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">复选项组</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-check md-example-child-check-1">
    <cu-check-group value="{{favorites}}" bind:change="noop">
      <cu-check name="watermelon" label="西瓜" />
      <cu-check name="apple" label="苹果" />
      <cu-check name="banana" label="香蕉" />
      <cu-check name="orange" label="橙子" />
      <cu-check name="tomato" label="西红柿" disabled />
    </cu-check-group>
	</view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">复选框</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-check md-example-child-check-2">
    <cu-check-box name="day" value="{{pay}}" bind:change="noop" label="日缴" disabled />
    <cu-check-box name="month" value="{{pay}}" bind:change="noop" label="月付" />
    <cu-check-box name="season" value="{{pay}}" bind:change="noop" label="季度费" />
	</view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">复选框组</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-check md-example-child-check-3">
    <cu-check-group value="{{insurants}}" bind:change="noop">
      <cu-check-box icon-position="lt" name="self" disabled>自己</cu-check-box>
      <cu-check-box icon-position="rt" name="couple" disabled>配偶</cu-check-box>
      <cu-check-box icon-position="lt" name="parent">父母</cu-check-box>
      <cu-check-box icon-position="rt" name="child">子女</cu-check-box>
    </cu-check-group>
	</view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">复选列表</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-check md-example-child-check-4">
    <cu-field title="复选列表">
      <cu-check-list
        ref="checkList"
        value="{{favorites}}" bind:change="noop"
        icon="right"
        icon-inverse=""
        options="{{fruits}}"
      />
      <cu-cell-item no-border>
        <cu-button type="primary" size="small" inline bind:tap="checkAll">全选</cu-button>
        <cu-button size="small" inline bind:tap="toggleAll">反选</cu-button>
      </cu-cell-item>
    </cu-field>
	</view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">复选列表</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-check md-example-child-check-4">
    <cu-field title="复选列表">
      <cu-check-list
        value="{{favorites}}" bind:change="noop"
        iconPosition="left"
        options="{{fruits}}"
      />
    </cu-field>
  </view>

    </view>
  </view>
</view>
