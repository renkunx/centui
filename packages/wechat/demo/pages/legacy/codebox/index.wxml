<view class="legacy-wrapper md-example codebox">
  <view class="legacy-section">
    <view class="legacy-title">基础</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-codebox md-example-child-codebox-0">
    <cu-codebox
      value="{{code}}" bind:change="noop"
      maxlength="{{4}}"
      autofocus
    />
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">掩码遮蔽</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-codebox md-example-child-codebox-1">
    <cu-codebox
      mask="{{true}}"
      maxlength="{{6}}"
      value="{{code}}" bind:change="noop"
    />
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">不限长度</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-codebox md-example-child-codebox-2">
    <cu-codebox
      maxlength="{{-1}}"
      value="{{code}}" bind:change="noop"
    />
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">系统键盘</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-codebox md-example-child-codebox-3">
    <cu-codebox
      maxlength="{{-1}}"
      value="{{code}}" bind:change="noop"
      system
    />
  </view>

    </view>
  </view>
</view>
