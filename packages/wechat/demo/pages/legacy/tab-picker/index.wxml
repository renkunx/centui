<view class="legacy-wrapper md-example tab-picker">
  <view class="legacy-section">
    <view class="legacy-title">基础</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-tab-picker md-example-child-tab-picker-0">
    <cu-field title="地址">
      <cu-field-item
        title="联系地址"
        arrow="arrow-right"
        bind:click="toggleShow"
        placeholder="请选择联系地址"
        content="{{addressStr}}"
        solid
      />
    </cu-field>
    <cu-tab-picker
      title="请选择"
      describe="请选择您所在的省份、城市、区县"
      large-radius
      data="{{data}}"
      show="{{show}}"
      bind:change="handleChange"
    />
  </view>

    </view>
  </view>
</view>
<!--
  平台差异说明（对齐 legacy/components/tab-picker/demo/cases/demo0.vue）：
  - @click="show = !show" 改为 bind:click="toggleShow"；v-model 改为 show 属性 + change 事件回写
  - computed addressStr 改为 handleChange 里 setData 派生字段
-->
