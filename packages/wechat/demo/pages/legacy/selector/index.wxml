<view class="legacy-wrapper md-example selector">
  <view class="legacy-section">
    <view class="legacy-title">无需确认</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-selector md-example-child-selector-0">
    <cu-field>
      <cu-field-item
        title="普通模式"
        content="{{selectorValue0}}"
        bind:click="showSelector0"
        arrow
        solid
      />
    </cu-field>
    <cu-selector
      show="{{isSelectorShow0}}"
      bind:change="onSelectorShowChange0"
      default-value="2"
      data="{{data0}}"
      max-height="320px"
      title="普通模式"
      large-radius
      bind:choose="onSelectorChoose0"
    ></cu-selector>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">自定义选项</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-selector md-example-child-selector-1">
    <cu-field>
      <cu-field-item
        title="自定义"
        content="{{selectorValue1}}"
        bind:click="showSelector1"
        arrow
        solid
      />
    </cu-field>
    <cu-selector
      show="{{isSelectorShow1}}"
      bind:change="onSelectorShowChange1"
      data="{{data1}}"
      hide-title-bar
      large-radius
      is-check
      icon-size="lg"
      bind:choose="onSelectorChoose1"
    >
      <view class="selector-header" slot="header">
        Header Slot
      </view>
      <view class="selector-footer" slot="footer">
        Footer Slot
      </view>
    </cu-selector>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">确认模式</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-selector md-example-child-selector-2">
    <cu-field>
      <cu-field-item
        title="确认模式"
        content="{{selectorValue2}}"
        bind:click="showSelector2"
        arrow
        solid
      />
    </cu-field>
    <cu-selector
      show="{{isSelectorShow2}}"
      bind:change="onSelectorShowChange2"
      data="{{data2}}"
      min-height="320px"
      title="确认模式"
      ok-text="确认"
      large-radius
      bind:confirm="onSelectorConfirm2"
    ></cu-selector>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">Check模式</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-selector md-example-child-selector-3">
    <cu-field>
      <cu-field-item
        title="Check模式"
        content="{{selectorValue3}}"
        bind:click="showSelector3"
        arrow
      />
    </cu-field>
    <cu-selector
      show="{{isSelectorShow3}}"
      bind:change="onSelectorShowChange3"
      data="{{data3}}"
      title="Check模式"
      min-height="320px"
      ok-text="确认"
      cancel-text="取消"
      large-radius
      bind:confirm="onSelectorConfirm3"
      is-check
    ></cu-selector>
  </view>

    </view>
  </view>
  <view class="legacy-section">
    <view class="legacy-title">多选模式</view>
    <view class="legacy-content">

  <view class="md-example-child md-example-child-selector md-example-child-selector-4">
    <cu-field>
      <cu-field-item
        title="多选模式"
        content="{{selectorValue4Str}}"
        bind:click="showSelector4"
        arrow
      />
    </cu-field>
    <cu-selector
      show="{{isSelectorShow4}}"
      bind:change="onSelectorShowChange4"
      data="{{data4}}"
      default-value="{{selectorValue4}}"
      title="多选模式"
      min-height="320px"
      ok-text="确定"
      cancel-text="取消"
      large-radius
      bind:confirm="onSelectorConfirm4"
      multi
    ></cu-selector>
  </view>

    </view>
  </view>
</view>
<!--
  平台差异说明（对齐 legacy/components/selector/demo/cases/demo0~4.vue）：
  - {{selectorValue.join(',')}} 改为页面 data 字段 selectorValue4Str，confirm 处理器内 join
  - v-model 均改为 show 属性 + change 事件回写；@click="showSelector" 改为 bind:click
  - 五个 case 的 data/selectorValue 同名字段拆分为 *0~*4，保持各 case 独立数据
  - demo1 的 slot-scope 自定义选项（holder+title+brief 结构）无小程序作用域插槽等价物，
    改为组件内置 title+brief 渲染（brief = describe-序号），header/footer 插槽保留
-->
