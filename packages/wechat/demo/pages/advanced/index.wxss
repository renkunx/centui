/* 高级组件展示页骨架（非组件样式） */
.demo {
  padding-bottom: 60rpx;
}

.demo-section {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.demo-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #01080f;
  margin-bottom: 20rpx;
}

.demo-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.demo-wrap {
  flex-wrap: wrap;
}

.demo-block {
  margin-bottom: 24rpx;
}

.demo-label {
  font-size: 26rpx;
  color: #666f83;
}

.demo-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.demo-wm-box {
  position: relative;
  min-height: 200rpx;
  border: 2rpx dashed #e2e4ea;
  border-radius: 12rpx;
  overflow: hidden;
}

.demo-wm-content {
  padding: 40rpx 32rpx;
  font-size: 28rpx;
  color: #41485d;
  line-height: 1.6;
  white-space: pre-line;
}

.demo-transition-box {
  padding: 32rpx;
  background: #ebf5ff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #198cff;
  text-align: center;
}

.demo-scroll-box {
  height: 320rpx;
  border: 2rpx dashed #e2e4ea;
  border-radius: 12rpx;
}

.demo-scroll-item {
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  color: #41485d;
  border-bottom: 2rpx solid #f4f6f8;
}

.demo-landscape-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  color: #fff;
}

.demo-popup-title {
  font-size: 34rpx;
  font-weight: 600;
}
