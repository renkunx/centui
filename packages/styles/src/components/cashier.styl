/* Extracted from legacy/components/cashier — do not edit by hand; re-run scripts/extract.mjs */
/* --- index.vue --- */
.cu-cashier
  .cu-popup-title-bar .cu-popup-cancel
    .cu-icon
      align-self flex-start
      margin-left h-gap-lg
  .cu-popup-box
    background-color color-bg-inverse
    border-radius popup-title-bar-radius popup-title-bar-radius 0 0
  .cu-cashier-container
    block()
    position relative
    background cashier-bg
    -webkit-touch-callout none
    -webkit-user-select none
    transition all .3s
    overflow hidden
    .cu-cashier-block
      clearfix()
      .cu-cashier-block-icon
        position relative
        left 50%
        float left
        width 100px
        height 100px
        margin-top 75px
        transform translateX(-50%)
        .cu-activity-indicator-svg
          width 100px !important
          height 100px !important
      .cu-cashier-block-text
        block()
        margin-top 20px
        margin-bottom 180px
        font-size font-minor-large
        color color-text-minor
        text-align center
      .cu-cashier-block-btn
        block()
        padding 0 40px 40px
        box-sizing border-box
      // &.cu-cashier-choose

      &.cu-cashier-captcha
        .cu-captcha
          block()
        .cu-captcha-content
          margin-top 44px
          margin-bottom 20px
          color color-text-caption
        .cu-codebox
          margin-bottom 26px
        .cu-captcha-content,
        .cu-captcha-message,
        .cu-codebox,
        .cu-captcha-footer
          margin-left 40px
          margin-right 40px
        .cu-captcha-footer
          margin-bottom 44px

      &.cu-cashier-fail
        .cu-cashier-block-icon
          position relative
          text-align center
          line-height 100px
          .cu-icon-warn-color
            position relative
            z-index 2
            color #FFF6F1
            width 100px
            height 100px

/* --- channel-button.vue --- */
.cu-cashier-block-btn
  display flex
  .cu-button
    flex 1
    margin-right h-gap-md
    &:last-of-type
      margin 0

/* --- channel-item.vue --- */
.cu-cashier-channel-item
  block()
  position relative
  padding 20px 40px 20px 0
  box-sizing border-box
  // display flex
  // align-items center
  .item-icon, .item-image
    position relative
    float left
    width 32px
    height 32px
    margin 6px 0
  .item-image img
    block() 
  .item-label
    float left
    margin-left h-gap-sm
    .title
      font-size cashier-choose-channel-title-font-size
      color cashier-choose-channel-title-color
      .title-active
        padding-left h-gap-sm
        font-size cashier-choose-channel-title-action-font-size
        color cashier-choose-channel-title-action-color
    .desc
      margin-top v-gap-xs
      font-size cashier-choose-channel-desc-font-size
      color cashier-choose-channel-desc-color
  .item-check-icon
    position absolute
    top 50%
    right 0
    transform translateY(-50%)
    .cu-icon
      display flex
      color color-text-placeholder
      &.cu-icon-checked
        color cashier-choose-channel-icon-color

/* --- channel.vue --- */
.cu-cashier-channel
  .choose-text
    clearfix()
    position relative
    padding 65px 0 25px
    p
      block()
      text-align center
      &.choose-title
        font-size cashier-choose-title-font-size
        color cashier-choose-title-color
      &.choose-number
        margin-top 20px
        font-size cashier-choose-amount-font-size
        font-family font-family-number
        color cashier-choose-amount-color
        letter-spacing -2px
      &.choose-describe
        font-size cashier-choose-describe-font-size
        color cashier-choose-describe-color
  .choose-channel
    clearfix()
    max-height 500px
    padding 40px 60px
    box-sizing border-box
    overflow auto
    .choose-channel-list
      clearfix()
      // max-height 64px
      transition all .5s ease-in
      overflow hidden
      
    .choose-channel-more
      margin-top 10px
      font-size cashier-choose-more-font-size
      color cashier-choose-more-color
      text-align center
      &:after
        content ""
        position relative
        top 20px
        width 0
        height 0
        margin-left 10px
        border-left solid 8px transparent
        border-right solid 8px transparent
        border-top solid 8px color-text-caption
      &.disabled
        visibility hidden
    &.active
      .choose-channel-list .choose-channel-item
        display block
      .choose-channel-list
        max-height 1000px !important
