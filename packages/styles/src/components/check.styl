/* --- index.vue --- */
.md-check
  display flex
  align-items center
  margin-top v-gap-sm
  margin-bottom v-gap-sm
  &.is-checked
    .md-check-icon
      color check-color
  &.is-disabled
    .md-check-icon
    .md-check-label
      color color-text-disabled

.md-check-icon
  position relative
  color color-text-placeholder
  .md-icon
    display flex

.md-check-label
  margin-left h-gap-sm
  font-size inherit

/* --- list.vue --- */
.md-check-item
  .md-check
    margin-top 0
    margin-bottom 0
    pointer-events none
  .md-cell-item-body.multilines .md-cell-item-title
    font-weight font-weight-medium

.md-check-list.is-align-center
  .md-cell-item-content
    text-align center
  .md-cell-left,
  .md-cell-right
    display none
