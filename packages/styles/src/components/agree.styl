.md-agree
  display flex
  align-items center
  &.disabled
    opacity agree-disabled-opacity

.md-agree-icon
  display flex
  justify-content center
  align-items center
  align-self flex-start
  flex-shrink 0
  position relative
  margin-right h-gap-sm
  color agree-fill
  width 50px
  height 50px
  .md-agree-icon-container
    position relative
    .md-icon
      display flex
      will-change auto
      &.md-icon-checked,&.md-icon-square-checked
