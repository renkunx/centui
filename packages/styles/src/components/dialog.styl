/* Extracted from legacy/components/dialog — do not edit by hand; re-run scripts/extract.mjs */
/* --- dialog.vue --- */
.cu-dialog
  .cu-popup
    z-index dialog-zindex

.cu-dialog-content
  width dialog-width
  border-radius dialog-radius
  background-color color-bg-inverse
  overflow hidden

.cu-dialog-body
  color dialog-text-color
  font-size dialog-text-font-size
  text-align left
  padding dialog-body-padding

.cu-dialog-icon
  position relative
  display block
  width dialog-icon-size
  height dialog-icon-size
  margin v-gap-md auto 28px
.cu-dialog .cu-dialog-icon .cu-icon
.cu-dialog .cu-dialog-icon .cu-icon.icon-svg
.cu-dialog .cu-dialog-icon .cu-icon.icon-font
  display flex
  align-items center
  justify-content center
  position absolute
  top 0
  left 0
  width dialog-icon-size
  height dialog-icon-size
  fill dialog-icon-fill
  color dialog-icon-fill
  font-size dialog-icon-size
  line-height dialog-icon-size

.cu-dialog-close
  position absolute
  color dialog-close-color
  top 32px
  right 32px
  z-index 15

.cu-dialog-title
  color dialog-title-color
  text-align center
  font-size dialog-title-font-size
  font-weight font-weight-normal
  line-height 1.2
  margin 0 0 28px 0

.cu-dialog-text
  display flex
  justify-content center

.cu-dialog-actions
  position relative
  display flex
  hairline(top, dialog-action-border-color)
  &.is-column
    flex-direction column
    .cu-dialog-btn
      flex 0 0 auto
      remove-hairline(right)
      &:not(:first-child)
        hairline(top, dialog-action-border-color)
      &:last-child
        color color-text-minor
      &:first-child
        color dialog-action-highlight-color

.cu-dialog-btn
  position relative
  flex 1 1 0%
  display flex
  align-items center
  justify-content center
  height dialog-action-height
  font-size dialog-action-font-size
  font-weight dialog-action-font-weight
  color color-text-minor
  text-align center
  hairline(right, dialog-action-border-color)
  transition background-color .3s
  -webkit-user-select none
  -webkit-tap-highlight-color transparent
  &.warning
    color color-text-error !important
    .cu-dialog-btn-loading .cu-activity-indicator-svg .circle circle
      stroke color-text-error !important
  &.disabled
    color color-text-disabled !important
    .cu-dialog-btn-loading .cu-activity-indicator-svg .circle circle
      stroke color-text-disabled !important
  &:last-child
    color dialog-action-highlight-color
    remove-hairline(right)
    .cu-dialog-btn-loading .cu-activity-indicator-svg .circle circle
      stroke dialog-action-highlight-color 
  &:not(.disabled):active
    background-color color-bg-tap
  .cu-dialog-btn-loading .cu-activity-indicator-svg
    width 32px !important
    height 32px !important
    margin-right 10px
    .circle circle
      stroke color-text-minor
  .cu-dialog-btn-icon
    margin-right 10px
