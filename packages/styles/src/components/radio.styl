/* Extracted from legacy/components/radio — do not edit by hand; re-run scripts/extract.mjs */
/* --- index.vue --- */
.cu-radio
  display flex
  align-items center
  line-height 1.5
  margin-top v-gap-sm
  margin-bottom v-gap-sm
  .cu-radio-icon
    color color-text-placeholder
    .cu-icon
      display flex
  &.is-checked
    .cu-radio-icon
      color radio-color
  &.is-disabled
    .cu-radio-icon
    .cu-radio-label
      color color-text-disabled
  &.is-inline
    display inline-flex
    &:not(:last-child)
      margin-right 40px

.cu-radio-icon
  position relative
  flex-shrink 0

.cu-radio-label
  margin-left h-gap-sm
  font-size inherit
  font-weight font-weight-normal

/* --- list.vue --- */
.cu-radio-item
  .cu-radio
    margin-top 0
    margin-bottom 0

.cu-radio-list
  .cu-cell-item-body.multilines .cu-cell-item-title
    font-weight font-weight-medium
  &.is-align-center
    .cu-cell-item-content
      text-align center
    .cu-cell-left,
    .cu-cell-right
      display none
