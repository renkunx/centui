/* check-base 勾选视觉基座样式源。
   来源：legacy/components/check-base/box.vue（styles/scripts/extract.mjs 将
   check-base 列入 EXCLUDE 未抽取，此处对照 legacy 手工补齐，@centui/wechat 批次代理）。
   转换：md- 前缀 → cu-；legacy 变量 → theme.css-vars token（checkbox-* 全量存在）。
   注意：.cu-tag 与 .quarter-content/.quarter-bg 为 cu-tag 内部类，依赖本组件
   styleIsolation: shared 将规则提升页面级后命中（cu-tag/cu-icon 为 apply-shared）。 */
.cu-check-base-box
  position relative
  display inline-block
  text-align center
  color checkbox-color
  font-size checkbox-font-size
  padding v-gap-sm h-gap-md
  border 1px solid checkbox-border-color
  border-radius checkbox-border-radius
  box-sizing border-box
  background-color checkbox-background-color
  overflow hidden
  &.is-checked
    color checkbox-active-color
    border-color checkbox-active-border-color
    background-color checkbox-active-background-color
    font-weight bold
    &.is-disabled
      color checkbox-active-color
      border-color checkbox-active-border-color
      opacity 0.6
  &.is-disabled
    color checkbox-disabled-color
    border-color checkbox-disabled-color
    background-color checkbox-disabled-background-color

  .cu-tag
    position absolute
    top 0
    right 0
    .quarter-bg
      background-color checkbox-active-color

  &.lt
    .cu-tag
      left 0
      .quarter-content
        left -10%
      .quarter-bg
        left -100%
