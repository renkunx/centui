.cu-selector
  .cu-popup
    z-index selector-zindex
  // .cu-popup-title-bar .cu-popup-cancel
  //   .cu-icon
  //     align-self flex-start
  .cu-radio-item
    padding-left h-gap-sl
    padding-right h-gap-sl
    transition background-color .3s
    .cu-cell-item-body.multilines .cu-cell-item-title
      font-weight font-weight-normal
    &.is-selected
      .cu-cell-item-title
        color color-primary
    &:active
      background-color color-bg-tap
  &.is-check
    .cu-radio-item.is-selected
      .cu-cell-item-title
        color inherit
  .cu-check-item
    padding-left h-gap-sl
    padding-right h-gap-sl


.cu-selector-container
  padding-bottom constant(safe-area-inset-bottom)
  overflow hidden

.cu-selector
  &.is-normal
    .cu-radio-item
      text-align center
      .cu-cell-item-left,
      .cu-cell-item-right
        display none
