/* Extracted from legacy/components/tip — do not edit by hand; re-run scripts/extract.mjs */
/* --- tip.vue --- */
.cu-tip
  position relative
  display inline-block
  // max-width 400px
  z-index tip-zindex

.cu-tip-content
  clearfix()
  position relative
  padding tip-padding
  color tip-color
  font-size tip-font-size
  line-height 1.2
  z-index 2
  .content-icon
    float left
    margin-right 14px
  .content-text
    float left
    margin-top 2px


.cu-tip-bg
  position absolute
  absolute-pos()
  border-radius tip-radius
  background-color tip-fill
  box-shadow tip-shadow
  opacity tip-fill-opacity
  &::after
    content ''
    position absolute
    bottom -10px
    left 50%
    margin-left -11px
    width 0
    height 0
    border-style solid
    border-width 10px 11px 0 11px
    border-color tip-fill transparent transparent transparent

.cu-tip
  &.has-close
    .cu-tip-content
      padding-right 60px
  &.is-bottom
    .cu-tip-bg::after
      bottom auto
      top -10px
      border-width 0 11px 10px 11px
      border-color transparent transparent tip-fill transparent
  &.is-left
    .cu-tip-bg::after
      top 50%
      right -6px
      left auto
      margin-top -11px
      border-width 11px 0 11px 10px
      border-color transparent transparent transparent tip-fill
  &.is-right
    .cu-tip-bg::after
      top 50%
      left 4px
      margin-top -11px
      border-width 11px 10px 11px 0
      border-color transparent tip-fill transparent transparent

  .cu-icon.cu-icon-close
    position absolute
    right 16px
    top 50%
    width tip-close-size
    height tip-close-size
    transform translateY(-50%)
