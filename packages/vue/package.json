{
  "name": "mand-mobile",
  "version": "3.0.0-alpha.0",
  "description": "A Vue 3 based mobile UI toolkit, the successor of mand-mobile v2",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./es/activity-indicator": {
      "types": "./dist/activity-indicator.d.ts",
      "import": "./dist/activity-indicator.js",
      "require": "./dist/activity-indicator.cjs"
    },
    "./es/agree": {
      "types": "./dist/agree.d.ts",
      "import": "./dist/agree.js",
      "require": "./dist/agree.cjs"
    },
    "./es/amount": {
      "types": "./dist/amount.d.ts",
      "import": "./dist/amount.js",
      "require": "./dist/amount.cjs"
    },
    "./es/button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "require": "./dist/button.cjs"
    },
    "./es/cell-item": {
      "types": "./dist/cell-item.d.ts",
      "import": "./dist/cell-item.js",
      "require": "./dist/cell-item.cjs"
    },
    "./es/icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js",
      "require": "./dist/icon.cjs"
    },
    "./es/notice-bar": {
      "types": "./dist/notice-bar.d.ts",
      "import": "./dist/notice-bar.js",
      "require": "./dist/notice-bar.cjs"
    },
    "./es/progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js",
      "require": "./dist/progress.cjs"
    },
    "./es/skeleton": {
      "types": "./dist/skeleton.d.ts",
      "import": "./dist/skeleton.js",
      "require": "./dist/skeleton.cjs"
    },
    "./es/stepper": {
      "types": "./dist/stepper.d.ts",
      "import": "./dist/stepper.js",
      "require": "./dist/stepper.cjs"
    },
    "./es/switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js",
      "require": "./dist/switch.cjs"
    },
    "./es/tag": {
      "types": "./dist/tag.d.ts",
      "import": "./dist/tag.js",
      "require": "./dist/tag.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "playground": "vite playground"
  },
  "dependencies": {
    "@mand-mobile/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@mand-mobile/styles": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "vite-plugin-dts": "^5.1.0",
    "vue": "^3.5.13",
    "vue-tsc": "^3.0.0"
  }
}
