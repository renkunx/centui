{
  "name": "mand-mobile-repo",
  "version": "3.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "mand-mobile monorepo — Vue 3 / React multi-framework mobile UI toolkit",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "pnpm -r --filter './packages/*' run build",
    "golden:capture": "pnpm --filter @mand-mobile/golden run capture",
    "golden:test": "pnpm --filter @mand-mobile/golden run test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
