{
  "component": "cashier",
  "props": [
    {
      "name": "v-model",
      "desc": "收银台是否显示",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "channels",
      "desc": "支付渠道数据源",
      "type": "Array",
      "default": "[]",
      "required": false
    },
    {
      "name": "channel-limit",
      "desc": "支付渠道超出限制数目时展示更多支付渠道按钮",
      "type": "Number",
      "default": "2",
      "required": false
    },
    {
      "name": "default-index",
      "desc": "默认选中支付渠道索引",
      "type": "Number",
      "default": "0",
      "required": false
    },
    {
      "name": "title",
      "desc": "收银台弹窗标题",
      "type": "String",
      "default": "支付",
      "required": false
    },
    {
      "name": "large-radius  (2.4.0+)",
      "desc": "选择器标题栏大圆角模式",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "payment-title",
      "desc": "支付金额标题",
      "type": "String",
      "default": "支付金额(元)",
      "required": false
    },
    {
      "name": "payment-amount",
      "desc": "支付金额",
      "type": "String",
      "default": "0.00",
      "required": false
    },
    {
      "name": "payment-describe",
      "desc": "支付金额说明",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "pay-button-text",
      "desc": "确认支付按钮文案",
      "type": "String",
      "default": "确认支付",
      "required": false
    },
    {
      "name": "pay-button-disabled",
      "desc": "禁用支付按钮",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "more-button-text",
      "desc": "更多支付渠道按钮文案",
      "type": "String",
      "default": "更多支付方式",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@select(item: {text, value})",
      "desc": "支付渠道选中事件"
    },
    {
      "name": "@pay(item: {text, value})",
      "desc": "支付渠道确认并发起支付事件"
    },
    {
      "name": "@cancel()",
      "desc": "取消支付事件"
    },
    {
      "name": "@show()",
      "desc": "收银台弹窗展示事件"
    },
    {
      "name": "@hide()",
      "desc": "收银台弹窗隐藏事件"
    }
  ],
  "slots": [
    {
      "name": "header",
      "desc": "头部内容scoped插槽"
    },
    {
      "name": "footer",
      "desc": "底部内容scoped插槽"
    },
    {
      "name": "channel",
      "desc": "支付渠道区域插槽，可用于添加支付渠道特殊操作，如添加银行卡"
    },
    {
      "name": "payButton",
      "desc": "发起支付插槽"
    },
    {
      "name": "scene",
      "desc": "自定义场景插槽，使用next('custom')打开"
    }
  ],
  "methods": [
    {
      "name": "next(scene, option)",
      "desc": "进入收银台下一步"
    }
  ]
}