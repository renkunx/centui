{
  "component": "image-reader",
  "props": [
    {
      "name": "name",
      "desc": "标识",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "size",
      "desc": "图片尺寸限制",
      "type": "String/Number",
      "default": "-",
      "required": false
    },
    {
      "name": "mime",
      "desc": "支持图片类型",
      "type": "Array",
      "default": "*",
      "required": false
    },
    {
      "name": "is-camera-only",
      "desc": "是否只支持拍照",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "is-multiple",
      "desc": "是否支持选择多张",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "amount",
      "desc": "选择多张",
      "type": "Number",
      "default": "-",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@select(name, { files })",
      "desc": "图片选择完成事件，还未开始读取"
    },
    {
      "name": "@complete(name, { dataUrl, blob, file })",
      "desc": "图片选择读取完成事件"
    },
    {
      "name": "@error(name, { code, msg })",
      "desc": "图片选择读取失败事件"
    }
  ],
  "slots": []
}