{
  "component": "tabs",
  "props": [
    {
      "name": "v-model",
      "desc": "双向绑定的标签对象name",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "immediate",
      "desc": "初始化后立即就触发一次change事件",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "name",
      "desc": "唯一键名",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "label",
      "desc": "菜单标题",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "disabled",
      "desc": "是否禁用",
      "type": "Boolean",
      "default": "false",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@change(tab)",
      "desc": "当用户选择标签触发"
    }
  ],
  "slots": [],
  "methods": [
    {
      "name": "reflowTabBar()",
      "desc": "重新计算TabBar样式布局"
    }
  ]
}