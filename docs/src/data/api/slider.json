{
  "component": "slider",
  "props": [
    {
      "name": "v-model",
      "desc": "双向绑定的值, 当开启range时, 其值为数组形式",
      "type": "number, number[]",
      "default": "0",
      "required": false
    },
    {
      "name": "disabled",
      "desc": "是否禁用滑块",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "min",
      "desc": "可拖动的最小值",
      "type": "number",
      "default": "0",
      "required": false
    },
    {
      "name": "max",
      "desc": "可拖动的最大值",
      "type": "number",
      "default": "100",
      "required": false
    },
    {
      "name": "step",
      "desc": "步长",
      "type": "number",
      "default": "1",
      "required": false
    },
    {
      "name": "range",
      "desc": "是否启动双向拖动",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "format",
      "desc": "显示文本的格式化函数",
      "type": "Function",
      "default": "(val) => {return val}",
      "required": false
    }
  ],
  "events": [],
  "slots": []
}