{
  "component": "captcha",
  "props": [
    {
      "name": "v-model",
      "desc": "验证码窗口是否显示",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "is-view",
      "desc": "是否内嵌在页面内展示，否则以弹层形式",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "maxlength",
      "desc": "字符最大输入长度, 若为-1则不限制输入长度",
      "type": "Number",
      "default": "4",
      "required": false
    },
    {
      "name": "mask",
      "desc": "是否掩码",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "system",
      "desc": "是否使用系统默认键盘",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "auto-send  (2.5.8+)",
      "desc": "第一次展示时是否触发send事件，否则需手动点击发送按钮",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "auto-countdown",
      "desc": "手动点击发送按钮后是否自动开始倒计时，否则需手动调用countdown",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "title",
      "desc": "标题",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "brief",
      "desc": "描述",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "append-to",
      "desc": "挂载节点",
      "type": "HTMLElement",
      "default": "document.body",
      "required": false
    },
    {
      "name": "count",
      "desc": "倒计时时长, 设置为0的时候不显示倒计时按钮",
      "type": "Number",
      "default": "60",
      "required": false
    },
    {
      "name": "count-normal-text",
      "desc": "发送验证码正常状态文字",
      "type": "String",
      "default": "发送验证码",
      "required": false
    },
    {
      "name": "count-active-text",
      "desc": "发送验证码及倒计时按钮文案配置项",
      "type": "String",
      "default": "{$1}秒后重发",
      "required": false
    },
    {
      "name": "type",
      "desc": "验证码组件模式类型",
      "type": "String",
      "default": "dialog",
      "required": false
    },
    {
      "name": "disable-send",
      "desc": "发送验证码按钮是否禁用",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "subtitle",
      "desc": "副标题",
      "type": "String",
      "default": "''",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@show()",
      "desc": "验证码组件显示事件"
    },
    {
      "name": "@hide()",
      "desc": "验证码组件隐藏事件"
    },
    {
      "name": "@send(countdown)",
      "desc": "发送验证码事件, 第一次打开时或点击重发按钮后触发并开始倒计时，如果auto-countdown为false需手动调用countdown开始倒计时"
    },
    {
      "name": "@submit(code)",
      "desc": "用户提交输入内容事件"
    }
  ],
  "slots": [],
  "methods": [
    {
      "name": "countdown()",
      "desc": "开始倒计时"
    },
    {
      "name": "resetcount()",
      "desc": "重置倒计时"
    },
    {
      "name": "setError(message)",
      "desc": "设置报错信息并显示"
    }
  ]
}