{
  "component": "landscape",
  "props": [
    {
      "name": "v-model",
      "desc": "是否展示",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "has-mask",
      "desc": "是否有蒙层",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "mask-closable",
      "desc": "是否可以通过点击蒙层关闭",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "full-screen",
      "desc": "是否全屏",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "transition",
      "desc": "弹出层过渡动画",
      "type": "String",
      "default": "full-screen为true时，默认值md-fade；否则默认为md-punch",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@show()",
      "desc": "弹出层展示事件"
    },
    {
      "name": "@hide()",
      "desc": "弹出层隐藏事件"
    }
  ],
  "slots": []
}