{
  "component": "tab-bar",
  "props": [
    {
      "name": "v-model",
      "desc": "双向绑定的标签对象name",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "items",
      "desc": "标签标题数组",
      "type": "Array",
      "default": "-",
      "required": false
    },
    {
      "name": "has-ink",
      "desc": "是否显示下划线",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "ink-length",
      "desc": "下划线宽度",
      "type": "Number",
      "default": "100",
      "required": false
    },
    {
      "name": "immediate",
      "desc": "初始化后立即就触发一次change事件",
      "type": "Boolean",
      "default": "false",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@change(item, index, prevIndex)",
      "desc": "标签索引发生变化事件"
    }
  ],
  "slots": [],
  "methods": [
    {
      "name": "reflow()",
      "desc": "重新计算样式布局"
    }
  ]
}