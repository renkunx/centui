{
  "component": "drop-menu",
  "props": [
    {
      "name": "data",
      "desc": "数据源",
      "type": "Array",
      "default": "[]",
      "required": false
    },
    {
      "name": "default-value",
      "desc": "初始值",
      "type": "Array",
      "default": "[]",
      "required": false
    },
    {
      "name": "option-render",
      "desc": "返回各选项渲染内容",
      "type": "Function({text, disabled, ...}):String",
      "default": "-",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@change(barItem, listItem)",
      "desc": "选中某项事件"
    },
    {
      "name": "@show()",
      "desc": "下拉菜单展示事件"
    },
    {
      "name": "@hide()",
      "desc": "下拉菜单隐藏事件"
    }
  ],
  "slots": [],
  "methods": [
    {
      "name": "getSelectedValue(index): listItem",
      "desc": "获取某菜单项选中值"
    },
    {
      "name": "getSelectedValues(): listItems",
      "desc": "获取所有菜单项选中值"
    }
  ]
}