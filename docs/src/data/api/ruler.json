{
  "component": "ruler",
  "props": [
    {
      "name": "v-model",
      "desc": "双向绑定的值",
      "type": "Number",
      "default": "0",
      "required": false
    },
    {
      "name": "scope",
      "desc": "刻度尺范围",
      "type": "Number[]",
      "default": "[0, 100]",
      "required": false
    },
    {
      "name": "step",
      "desc": "刻度尺每一大格步数",
      "type": "Number",
      "default": "10",
      "required": false
    },
    {
      "name": "unit",
      "desc": "刻度尺每一小格步数",
      "type": "Number",
      "default": "1",
      "required": false
    },
    {
      "name": "min",
      "desc": "最小可滑动位置",
      "type": "Number",
      "default": "0",
      "required": false
    },
    {
      "name": "max",
      "desc": "最大可滑动位置",
      "type": "Number",
      "default": "100",
      "required": false
    },
    {
      "name": "stepTextPosition (2.2.1+)",
      "desc": "Step标志位置",
      "type": "String",
      "default": "'top'",
      "required": false
    },
    {
      "name": "stepTextRender (2.2.1+)",
      "desc": "自定义step文案",
      "type": "Function",
      "default": "noop",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@change(currentValue)",
      "desc": "值发生变化事件"
    }
  ],
  "slots": []
}