{
  "component": "selector",
  "props": [
    {
      "name": "v-model",
      "desc": "选择器是否可见",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "data",
      "desc": "数据源",
      "type": "Array",
      "default": "[]",
      "required": false
    },
    {
      "name": "default-value  (2.3.0+)",
      "desc": "选择器初始选中项的值",
      "type": "any",
      "default": "-",
      "required": false
    },
    {
      "name": "title",
      "desc": "选择器标题",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "describe",
      "desc": "选择器描述",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "ok-text",
      "desc": "选择器确认文案",
      "type": "String",
      "default": "-",
      "required": false
    },
    {
      "name": "cancel-text",
      "desc": "选择器取消文案",
      "type": "String",
      "default": "取消",
      "required": false
    },
    {
      "name": "large-radius  (2.4.0+)",
      "desc": "选择器标题栏大圆角模式",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "hide-title-bar  (2.4.0+)",
      "desc": "隐藏选择器标题栏",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "mask-closable",
      "desc": "点击蒙层是否可关闭弹出层",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "is-check",
      "desc": "是否有check图标",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "max-height",
      "desc": "选择器内容区域最高高度, 超出后可滚动",
      "type": "Number/String",
      "default": "auto",
      "required": false
    },
    {
      "name": "min-height",
      "desc": "选择器内容区域最小高度, 超出后可滚动",
      "type": "Number/String",
      "default": "auto",
      "required": false
    },
    {
      "name": "icon",
      "desc": "选中项的图标",
      "type": "String",
      "default": "checked",
      "required": false
    },
    {
      "name": "icon-inverse",
      "desc": "非选中项的图标",
      "type": "String",
      "default": "check",
      "required": false
    },
    {
      "name": "icon-disabled",
      "desc": "禁用项的图标",
      "type": "String",
      "default": "check-disabled",
      "required": false
    },
    {
      "name": "icon-size",
      "desc": "图标大小",
      "type": "String",
      "default": "lg",
      "required": false
    },
    {
      "name": "icon-svg",
      "desc": "使用svg图标",
      "type": "Boolean",
      "default": "false",
      "required": false
    },
    {
      "name": "icon-position",
      "desc": "图标位置",
      "type": "String",
      "default": "right",
      "required": false
    },
    {
      "name": "multi (2.3.0+)",
      "desc": "支持多选",
      "type": "Boolean",
      "default": "false",
      "required": false
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "desc": "html"
    },
    {
      "name": "header",
      "desc": "顶部插槽  (2.4.0+)"
    },
    {
      "name": "footer",
      "desc": "底部插槽  (2.4.0+)"
    }
  ]
}