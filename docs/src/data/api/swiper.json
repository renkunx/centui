{
  "component": "swiper",
  "props": [
    {
      "name": "autoplay",
      "desc": "自动切换间隔时长(毫秒), 禁用可设置为0",
      "type": "Number",
      "default": "3000",
      "required": false
    },
    {
      "name": "transition",
      "desc": "面板切换动画效果",
      "type": "String",
      "default": "slide",
      "required": false
    },
    {
      "name": "transition-duration",
      "desc": "面板切换动画时长",
      "type": "Number",
      "default": "250",
      "required": false
    },
    {
      "name": "default-index",
      "desc": "第一屏面板索引值",
      "type": "Number",
      "default": "0",
      "required": false
    },
    {
      "name": "has-dots",
      "desc": "\b控制面板指示点",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "is-prevent",
      "desc": "阻止默认的事件，如页面滚动事件",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "is-loop",
      "desc": "循环播放",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "dragable",
      "desc": "禁用触摸滑动",
      "type": "Boolean",
      "default": "true",
      "required": false
    },
    {
      "name": "use-native-driver",
      "desc": "开启3D加速",
      "type": "Boolean",
      "default": "true",
      "required": false
    }
  ],
  "events": [
    {
      "name": "@beforeChange(from, to)",
      "desc": "轮播器将要切换前的事件"
    },
    {
      "name": "@afterChange(from, to)",
      "desc": "轮播器切换完成时的事件"
    }
  ],
  "slots": [],
  "methods": [
    {
      "name": "play(autoplay)",
      "desc": "打开自动切换"
    },
    {
      "name": "stop()",
      "desc": "停止自动切换"
    },
    {
      "name": "prev()",
      "desc": "前一个item"
    },
    {
      "name": "next()",
      "desc": "后一个item"
    },
    {
      "name": "goto(index)",
      "desc": "切换到某一个index"
    },
    {
      "name": "getIndex()",
      "desc": "获取当前显示的index"
    }
  ]
}