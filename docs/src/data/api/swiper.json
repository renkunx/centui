{
  "component": "swiper",
  "props": [
    {
      "name": "autoplay",
      "type": "number",
      "default": "3000",
      "desc": "自动切换间隔（ms），0 表示不自动切换",
      "required": false
    },
    {
      "name": "transition",
      "type": "string",
      "default": "'slide'",
      "desc": "切换效果：slide / slideY / fade",
      "required": false
    },
    {
      "name": "transitionDuration",
      "type": "number",
      "default": "250",
      "desc": "切换动画时长（ms）",
      "required": false
    },
    {
      "name": "defaultIndex",
      "type": "number",
      "default": "0",
      "desc": "初始展示索引",
      "required": false
    },
    {
      "name": "hasDots",
      "type": "boolean",
      "default": "true",
      "desc": "是否显示指示器",
      "required": false
    },
    {
      "name": "isLoop",
      "type": "boolean",
      "default": "true",
      "desc": "是否循环播放",
      "required": false
    },
    {
      "name": "isPrevent",
      "type": "boolean",
      "default": "true",
      "desc": "是否阻止默认事件",
      "required": false
    },
    {
      "name": "dragable",
      "type": "boolean",
      "default": "true",
      "desc": "是否可拖拽",
      "required": false
    },
    {
      "name": "useNativeDriver",
      "type": "boolean",
      "default": "true",
      "desc": "是否使用原生驱动（translate3d）",
      "required": false
    }
  ],
  "events": [
    {
      "name": "beforeChange",
      "desc": "切换前触发，参数 (fromIndex, toIndex)"
    },
    {
      "name": "afterChange",
      "desc": "切换后触发，参数 (fromIndex, toIndex)"
    }
  ],
  "slots": [
    {
      "name": "default",
      "desc": "轮播内容，子元素为 CuSwiperItem"
    }
  ],
  "methods": [
    {
      "name": "next()",
      "desc": "切换到下一页"
    },
    {
      "name": "prev()",
      "desc": "切换到上一页"
    },
    {
      "name": "goto(index)",
      "desc": "切换到指定展示索引"
    },
    {
      "name": "getIndex()",
      "desc": "获取当前展示索引"
    },
    {
      "name": "play(duration)",
      "desc": "开始自动播放"
    },
    {
      "name": "stop()",
      "desc": "停止自动播放"
    }
  ]
}